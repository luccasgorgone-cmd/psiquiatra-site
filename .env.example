# ==== Banco de dados (Railway Postgres) ====
# No Railway, use a variável de referência ${{ Postgres.DATABASE_URL }}
DATABASE_URL="postgresql://usuario:senha@host:5432/railway"

# ==== Autenticação do painel ====
# OBRIGATÓRIO. Sem AUTH_SECRET (>= 32 caracteres) a aplicação não sobe.
# Gere um segredo forte: openssl rand -base64 32
AUTH_SECRET="<gere-com-openssl-rand-base64-32>"

# Admin inicial criado pelo seed (troque a senha depois no painel).
# ADMIN_EMAIL pode ser um e-mail OU um usuário simples.
# Defina AMBOS para que o seed crie o admin. Se não definir, NENHUM admin é
# criado automaticamente (sem credencial padrão conhecida em produção).
ADMIN_EMAIL="<seu-email-ou-usuario-admin>"
ADMIN_PASSWORD="<defina-uma-senha-forte>"
ADMIN_NAME="<Nome do administrador>"

# Apenas DESENVOLVIMENTO: se ADMIN_EMAIL/ADMIN_PASSWORD não estiverem definidos,
# defina SEED_DEFAULT_ADMIN="true" para o seed criar um admin local padrão.
# NUNCA habilite em produção.
# SEED_DEFAULT_ADMIN="false"

# ==== TLS do Postgres ====
# Para endpoints remotos/públicos, o certificado é validado (fail-closed em prod).
# Forneça o PEM da CA do endpoint (valor do dono da infra). Hosts internos
# *.railway.internal dispensam SSL.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# URL pública do site (usada em links/OG). Ex.: https://seusite.com.br
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# (Opcional) Domínio separado só para o painel admin.
# Se definido, o /admin fica acessível SOMENTE nesse host (ex.: admin.seusite.com
# ou seu-app-admin.up.railway.app) e é bloqueado (404) no domínio público.
# Deixe vazio para manter o painel no mesmo domínio (em /admin).
ADMIN_HOST=""

# ==== Evolution API (WhatsApp) ====
# Preencha aqui OU direto no painel (Integrações). Painel tem prioridade.
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""
# Token que a Evolution deve enviar no header do webhook (validação)
EVOLUTION_WEBHOOK_TOKEN=""
